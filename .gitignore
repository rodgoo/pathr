# Segredos. O .env.example é versionado; o .env.local, nunca — ele carrega as
# chaves do Supabase, dos provedores de IA e do Brevo.
.env
.env.local
*.local

# Dependências e artefatos de build
node_modules/
dist/
.venv/
__pycache__/
*.pyc
*.tsbuildinfo

# Ferramentas
# O flyctl fica dentro do projeto (backend/.fly), e nao instalado na maquina:
# a versao do CLI que faz o deploy passa a ser uma escolha deste repositorio,
# nao do que estava no PATH de quem rodou.
.fly/
.pytest_cache/
coverage/
.DS_Store
