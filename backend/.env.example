# Copie para .env.local e preencha. Nenhum valor real entra no repositório.

ENVIRONMENT=development

# --- Supabase: projeto EXCLUSIVO do PathR ---
# Crie um projeto NOVO (supabase.com -> New project). Não reaproveite o de
# outro app: nada aqui é compartilhado — banco, storage, chaves de IA e
# remetente de e-mail são todos do PathR.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A chave SECRETA do servidor (Project Settings -> API Keys). O Supabase
# renomeou as chaves em 2025: num projeto novo ela aparece como "secret key"
# (sb_secret_...), num antigo como "service_role" (um JWT). O app aceita os
# dois nomes de variável — use o que o seu painel mostrar.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (nome antigo, equivalente)
#
# A chave "publishable"/anon NÃO é usada aqui: o frontend nunca fala com o
# Supabase direto, só com esta API.
# Só o Alembic usa. Use a string do POOLER (aws-...pooler.supabase.com):
# o host direto db.<ref>.supabase.co resolve apenas em IPv6.
DATABASE_URL=postgresql+psycopg://postgres.SEU-REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Bucket do Storage para os currículos. Crie como PRIVADO.
RESUME_BUCKET=pathr-resumes

# --- Origens e cookies ---
FRONTEND_URL=https://localhost:5173
API_URL=https://localhost:8031
CORS_ORIGINS=["https://localhost:5173","http://localhost:5173"]
COOKIE_SAMESITE=strict
# Em produção: .notter.com.br (com o ponto), para o cookie emitido por
# api.pathr.notter.com.br acompanhar pathr.notter.com.br.
COOKIE_DOMAIN=

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- E-mail (Brevo, conta do próprio PathR) ---
# O remetente precisa ser de um domínio verificado na conta. Sem estas
# variáveis o cadastro funciona, mas o link de confirmação só aparece no log
# do servidor (services/email.py) — não é opcional em produção.


# --- Provedores de IA ---
# Chaves EXCLUSIVAS do PathR — contas próprias nos provedores, não as de
# outro app. É o que faz o cooldown daqui (app/ai_providers.py) refletir a
# cota daqui, e não a de terceiros. Crie chaves novas nos links abaixo.
#
# Cada variável aceita uma LISTA separada por vírgula. Duas chaves do mesmo
# provedor viram dois candidatos com cotas independentes na rotação:
#   GEMINI_API_KEY=chave1,chave2,chave3
# É a forma mais barata de aumentar o teto diário sem pagar nada.
#
# O Gemini é o único com visão configurada, e é ele que lê o PDF do currículo
# direto. Configure ao menos ele.
GEMINI_API_KEY=         # https://aistudio.google.com/apikey
GROQ_API_KEY=           # https://console.groq.com/keys
OPENROUTER_API_KEY=     # https://openrouter.ai/keys  (slugs :free)
MISTRAL_API_KEY=        # https://console.mistral.ai/api-keys
CEREBRAS_API_KEY=       # https://cloud.cerebras.ai


# --- Busca de material para a biblioteca ---
# Alimentam app/services/resource_search.py, que preenche o catálogo
# `pathr_resource`. Sem nenhuma das duas, a busca cai na curadoria por IA e
# usa as chaves de LLM acima — funciona, mas rende menos: o modelo só é
# confiável para documentação oficial, e todo link ainda passa por
# verificação antes de virar linha.
#
# COTA, não custo, é o que aperta aqui. `search.list` da YouTube Data API
# custa 100 das 10.000 unidades diárias: ~99 buscas por dia para o app
# INTEIRO, somando todos os usuários. Por isso a curadoria é por tag
# (compartilhada entre todo mundo) e tem carência de 14 dias por tag, em
# `pathr_tag.curated_at`.
YOUTUBE_API_KEY=
# Um buscador para artigo — preencha UM dos dois. Com os dois, o Tavily ganha:
# ele já devolve um resumo por resultado, e o do Brave vem cortado.
TAVILY_API_KEY=       
BRAVE_API_KEY=          # https://brave.com/search/api

# Vagas: a Adzuna é opcional (Gupy e Remotive não pedem chave). https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Disparo de avisos por e-mail ---
# Segredo que o cron (.github/workflows/emails.yml) apresenta no cabeçalho
# X-Pathr-Jobs-Secret. O MESMO valor precisa estar no segredo PATHR_JOBS_SECRET
# do repositório no GitHub. Vazio desliga o disparo: melhor não mandar nada do
# que deixar a rota aberta.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBS_SECRET=

# --- Tradução do módulo de idioma ---
# DeepL: traduz para português as frases do treino e a consulta de palavra,
# mantendo os termos de programação em inglês (glossário criado sozinho).
# Opcional: vazio, vale a tradução do modelo de IA. Chave ":fx" = plano Free.
#   https://www.deepl.com/pro-api
DEEPL_API_KEY=

# --- Quem administra esta instalação ---
# VAZIO por padrão no código, de propósito: um e-mail fixo lá dentro daria
# poder de admin ao dono da instalação original em toda cópia do projeto.
# Declare os seus aqui (JSON, comparado sem distinção de maiúsculas).
SUPER_ADMIN_EMAILS=["voce@exemplo.com"]
MODERATOR_EMAILS=["voce@exemplo.com"]

# --- Cifra dos dados sensíveis ---
# Currículo analisado, respostas de formulário e carta são cifrados no banco.
# Gere com: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# Chaves ANTIGAS, separadas por vírgula, durante uma troca de chave: o app
# ainda decifra com elas, mas só grava com a nova.
DATA_ENCRYPTION_KEYS_OLD=

# --- Sessão ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Tentativas erradas antes de travar a conta, e por quantos minutos.
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- E-mail (Brevo) ---
# Sem isto o app sobe, mas ninguém confirma cadastro nem recupera senha.
BREVO_API_KEY=
# Precisa ser um remetente VERIFICADO no painel da Brevo.
BREVO_FROM_EMAIL=
BREVO_SENDER_NAME=PathR

# --- Passkeys (WebAuthn) ---
# O domínio do site, SEM esquema nem porta (ex.: pathr.notter.com.br). Em
# desenvolvimento, localhost. Uma passkey criada num domínio não vale noutro.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PathR

# --- Modelos de IA ---
# Cada provedor tem a sua chave (GEMINI_API_KEY, GROQ_API_KEY, ...). Estes são
# os modelos usados em cada um; troque se o provedor aposentar algum.
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=qwen/qwen3.8-flash
MISTRAL_MODEL=open-mistral-nemo
CEREBRAS_MODEL=gpt-oss-120b
# Teto de tempo de uma geração, para a requisição não ficar pendurada.
AI_BUDGET_SECONDS=50

# --- Limites de upload (MB) ---
MAX_RESUME_MB=10
MAX_AVATAR_MB=5
# Teto do corpo de QUALQUER requisição; precisa ser maior que os de cima.
MAX_REQUEST_MB=12

# --- Buckets do Storage (crie como PRIVADOS) ---
AVATAR_BUCKET=pathr-avatars
REPORT_BUCKET=pathr-reports

# --- Tarefas agendadas ---
# Segredo que a varredura diária apresenta para rodar (ver docs/varredura-diaria.md).
SCAN_SECRET=
# Proteção anti-robô do cadastro (Cloudflare Turnstile). Vazio = desligada.
TURNSTILE_SECRET_KEY=

# --- Outros ---
APP_NAME=PathR
DEBUG=false
