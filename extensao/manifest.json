{
  "manifest_version": 3,
  "name": "PathR Extension",
  "description": "Preenche formulários de vaga com o que o PathR já sabe sobre você. Você confere e envia.",
  "version": "1.0.0",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "Preencher com o PathR",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "background": {
    "service_worker": "src/fundo.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.pathr.notter.com.br/*"],
  "optional_host_permissions": ["http://localhost/*", "https://localhost/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/painel.css", "icones/icone-48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
