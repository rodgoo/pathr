# Borda de produção do PathR.
#
# Termina TLS de verdade (Let's Encrypt, emitido e renovado sozinho) para os
# dois hosts e encaminha para os containers pela rede privada do Docker, que
# não é alcançável de fora — só este Caddy é.
#
# Dois hosts, mesmo registrable domain:
#   pathr.notter.com.br      -> SPA estático (frontend)
#   api.pathr.notter.com.br  -> esta API
#
# Estarem os dois sob notter.com.br é o que permite COOKIE_SAMESITE=strict:
# subdomínios do mesmo domínio registrável são same-site, então o cookie de
# sessão emitido pela API acompanha as requisições do app. Se a API morasse em
# outro domínio, seria cross-site e só SameSite=None funcionaria — perdendo a
# proteção contra CSRF que o Strict dá de graça.

{
	email {$ACME_EMAIL}
}

{$DOMAIN_API} {
	reverse_proxy pathr-backend:8031 {
		# Descarta o que o CLIENTE mandou nestes headers antes de definir os
		# nossos. Sem isso, qualquer um poderia forjar o IP de origem batendo
		# direto neste Caddy e cegar tudo que depende dele: o bloqueio por
		# tentativas de login, o limite do forgot-password e a própria trilha
		# de auditoria em pathr_security_event. Este Caddy é o único salto
		# entre a internet e o backend, então é aqui que "o que o cliente
		# alega" vira "o que a conexão TCP mostra".
		header_up -Cf-Connecting-Ip
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

{$DOMAIN_APP} {
	root * /srv/pathr
	encode gzip zstd

	# Mesmos cabeçalhos de segurança de frontend/public/_headers (que só o
	# Cloudflare Pages honra) — o Caddy não lê aquele arquivo, é uma convenção
	# específica do Pages. Sem isto, quem sobe o PathR via self-host perde a
	# camada toda: sem frame-ancestors/X-Frame-Options a tela de "excluir
	# conta" pode ser enquadrada por outro site (clickjacking); sem CSP um XSS
	# que escape da sanitização nh3 do modo leitura roda sem contenção; sem
	# HSTS o primeiro acesso HTTP não é forçado a HTTPS. Mantenha as duas
	# listas em sincronia — mesmas origens, mesmo motivo por origem, só a
	# sintaxe muda.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://challenges.cloudflare.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.pathr.notter.com.br; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob: data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	# Os assets com hash no nome nunca mudam de conteúdo — podem ser
	# cacheados para sempre.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# O index.html NÃO pode ser cacheado: é ele que aponta para os assets
	# novos depois de um deploy.
	@index path /index.html /
	header @index Cache-Control "no-cache"

	# O service worker e o manifest também não. O sw.js é o que sabe quais
	# arquivos existem nesta versão; se o navegador servir uma cópia velha
	# dele, o deploy simplesmente não chega a quem já instalou o app — e não
	# há como forçar, porque a pessoa não recarrega um app de tela de início.
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"

	# SPA: qualquer rota desconhecida devolve o index e o roteamento acontece
	# no navegador.
	try_files {path} /index.html
	file_server
}
